"""
Whether the organisation tracks time through chronix. The link key is never
returned: only whether it is linked and the chronix organisation's name.
"""
type TimeLink {
  linked: Boolean!
  "The chronix organisation, null when not linked."
  organisationName: String
}

enum TimeStatus {
  "`totalSeconds` and the rest are set."
  AVAILABLE
  "The organisation has no chronix link."
  UNLINKED
  "chronix did not answer (or refused the key): the issue works, its time is not shown."
  UNAVAILABLE
  "The viewer may not read time (`time:read`), has no verified e-mail, or is not a member of the chronix organisation."
  FORBIDDEN
}

"""
The time spent on an issue, read from chronix. Every number is null unless
`status` is AVAILABLE; a chronix outage is `UNAVAILABLE`, never an error.
"""
type TimeSpent {
  status: TimeStatus!
  "Seconds, all members."
  totalSeconds: Int
  "Seconds, the viewer's own share."
  mySeconds: Int
  entryCount: Int
  "Whether someone's timer runs on the issue now."
  running: Boolean
  """
  The viewer's own running timer, when it runs on this issue. Null when none
  does, when the viewer may not write time (`time:write`), when the organisation
  is not linked, or when chronix does not answer.
  """
  myRunningTimer: IssueTimer
}

"A timer started on an issue."
type IssueTimer {
  startedAt: DateTime!
  "On `startIssueTimer`: the seconds of the timer this one replaced (chronix saves it), null when none ran. Always null on `myRunningTimer`."
  stoppedSeconds: Int
}

"A time entry logged on an issue."
type LoggedTime {
  id: ID!
  date: String!
  durationSeconds: Int!
  description: String
  billable: Boolean!
}

input LogIssueTimeInput {
  "YYYY-MM-DD, in the chronix organisation's time zone."
  date: String! @constraint(format: "date")
  "60 to 86400."
  durationSeconds: Int! @constraint(min: 60, max: 86400)
  description: String @constraint(maxLength: 2000)
  "Defaults to the chronix project's setting."
  billable: Boolean
}

extend type Issue {
  "Time spent on the issue (chronix). Never null, never an error: see `TimeSpent.status`."
  timeSpent: TimeSpent!
}

type Query {
  "Whether the organisation is linked to chronix. Needs `time:read`."
  timeLink: TimeLink!
}

type Mutation {
  """
  Links the organisation to chronix with a link key (`chx_link_...`, made by an
  admin in chronix). The key is checked, sealed and stored; it is never
  returned. Needs `time:manage` (admin, owner) and a fresh session (403
  `auth.errors.step-up-required`). 400 `time.errors.invalid-key`; 422
  `time.errors.key-mismatch` (the key is another application's or another
  organisation's); 503 `time.errors.unavailable`.
  """
  linkChronix(key: String! @constraint(minLength: 1, maxLength: 200)): TimeLink!
  "Forgets the key. Entries and references stay in chronix. Needs `time:manage` and a fresh session."
  unlinkChronix: TimeLink!
  """
  Starts the viewer's timer on the issue (chronix stops and saves the one
  running). Needs `time:write`. 403 `time.errors.email-unverified` (the
  account's e-mail is not verified); 409 `time.errors.not-linked`; 422
  `time.errors.project-not-mapped`; 403 `time.errors.forbidden`; 503
  `time.errors.unavailable`.
  """
  startIssueTimer(issueId: ID!): IssueTimer!
  """
  Stops the viewer's running timer when it runs on this issue and returns the
  entry chronix saved; null when none runs or it runs on another issue (it
  keeps running: a stale tab never stops another issue's timer). Two chronix
  calls, so a timer changed in between is accepted. `issueId` must exist. Needs `time:write`. Same errors as
  `startIssueTimer` (403 `time.errors.email-unverified`, 409
  `time.errors.not-linked`, 403 `time.errors.forbidden`, 503
  `time.errors.unavailable`).
  """
  stopIssueTimer(issueId: ID!): LoggedTime
  """
  Logs time by hand on the issue. Needs `time:write`. 403
  `time.errors.email-unverified`; 409
  `time.errors.not-linked` or `time.errors.period-locked`; 422
  `time.errors.project-not-mapped`; 403 `time.errors.forbidden`; 429
  `time.errors.rate-limited`; 503 `time.errors.unavailable`.
  """
  logIssueTime(issueId: ID!, input: LogIssueTimeInput!): LoggedTime!
}
