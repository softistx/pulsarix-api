enum IssuePriority {
  none
  low
  medium
  high
  urgent
}

"""
The kind of an issue, the same set in every project. An `epic` has no parent;
a `story`, `task` or `bug` may have an `epic` as parent; a `subTask` must have
a `story`, `task` or `bug` as parent.
"""
enum IssueType {
  epic
  story
  task
  bug
  subTask
}

enum ClientMarker {
  "A reporter marked a request of the issue resolved."
  resolved
  "A reporter reopened a request of the issue."
  reopened
  "A reporter erased their data."
  deleted
}

"""
Where an issue's priority came from: `client` is the reporter's impact,
prefilled when the report was accepted; `team` is what a member set or
changed; `auto` is kept for a later automatic level.
"""
enum PriorityOrigin {
  client
  team
  auto
}

"""
An issue of a project. Its `key` (`ABC-12`) is the project's key and its
`number`, which counts from 1 with no gap.
"""
type Issue {
  id: ID!
  projectId: ID!
  number: Int!
  key: String!
  title: String!
  "An issue stored before the types reads as `task`."
  type: IssueType!
  "Rich text, as the client wrote it."
  description: String!
  statusId: ID!
  priority: IssuePriority!
  priorityOrigin: PriorityOrigin!
  assigneeId: ID
  labelIds: [ID!]!
  parentId: ID
  "Its children, done out of all (the cancelled ones left out)."
  progress: IssueProgress!
  startDate: DateTime
  dueDate: DateTime
  "The estimate in hours, or null. The time spent is `timeSpent` (chronix)."
  estimateHours: Float
  "Story points (1, 2, 3, 5, 8, 13 or 21) on a Story, Task or Bug; null for none. An Epic's own are always null: read `progress.points`."
  points: Int
  "Its place among the issues of its status (a string that sorts by plain order); move it with `moveIssue`."
  rank: String!
  "The sprint it is planned in; null is the backlog (a Sub-task has none: it follows its parent). Plan it with `planIssues`."
  sprintId: ID
  "Its place among the issues of its sprint or of the backlog (a string that sorts by plain order); set by `planIssues`."
  planRank: String!
  "The member who made it."
  reporterId: ID
  "The client report it was accepted from, if any."
  clientReportId: ID
  watcherIds: [ID!]!
  """
  A reporter wrote last on one of its client reports and no public reply has
  answered since: the "client reply" indicator.
  """
  clientWaiting: Boolean!
  "What reporters did to its requests: resolved or reopened (the latest), and deleted once one erased their data."
  clientMarkers: [ClientMarker!]!
  "Whether the viewer watches it."
  watching: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
}

"""
The children of an issue: `done` is how many stand in a status of the `done`
category, `total` how many there are; children in a `cancelled` status count
in neither.
"""
type IssueProgress {
  done: Int!
  total: Int!
  "The story points of the same children (the cancelled ones left out): an Epic's total."
  points: Int!
  "The story points of the children in a `done` status."
  pointsDone: Int!
}

type IssueConnection {
  nodes: [Issue!]!
  "Pass it as `after` for the next page; null on the last."
  endCursor: String
  hasNextPage: Boolean!
}

"Every given field narrows the list (they are combined with AND)."
input IssueFilter {
  statusIds: [ID!]
  "The issues whose status has one of these categories."
  categories: [StatusCategory!]
  priorities: [IssuePriority!]
  "The issues of ANY of these types (one stored before the types is a `task`)."
  types: [IssueType!]
  assigneeId: ID
  "Only the issues nobody is assigned to; ignored with `assigneeId`."
  unassigned: Boolean
  "The issues carrying ANY of these labels."
  labelIds: [ID!]
  "The children of this issue."
  parentId: ID
  "Only the issues with no parent; ignored with `parentId`."
  rootsOnly: Boolean
  "Only the Stories, Tasks and Bugs with no Epic (the roadmap's No Epic row); `types` narrows them, `parentId` wins."
  noEpic: Boolean
  reporterId: ID
  "Only the issues the viewer watches."
  watching: Boolean
  "Only the issues a reporter wrote last on and no public reply has answered."
  clientWaiting: Boolean
  "The issues planned in this sprint."
  sprintId: ID
  "Only the Stories, Tasks and Bugs in no sprint and still open (not in triage, done or cancelled); ignored with `sprintId` or `activeSprint`."
  backlog: Boolean
  "Only the issues of the project's active sprint (none when there is no active sprint); ignored with `sprintId`."
  activeSprint: Boolean
  "Part of the title, any case."
  text: String @constraint(maxLength: 200)
  startAfter: DateTime
  startBefore: DateTime
  "Due on or after (for a calendar's range)."
  dueAfter: DateTime
  dueBefore: DateTime
}

enum IssueSortField {
  rank
  "The plan order of the sprint or of the backlog."
  planRank
  number
  title
  priority
  points
  dueDate
  startDate
  createdAt
  updatedAt
}

enum SortDirection {
  asc
  desc
}

input IssueSort {
  field: IssueSortField!
  direction: SortDirection! = asc
}

"""
`statusId` defaults to the first Backlog status, `type` to `task`. `dueDate`
may not precede `startDate`; `assigneeId` must be a member; labels and the
parent belong to the project; the parent follows the rules of `IssueType`.
"""
input CreateIssueInput {
  projectId: ID!
  title: String! @constraint(minLength: 1, maxLength: 200)
  type: IssueType = task
  description: String @constraint(maxLength: 50000)
  statusId: ID
  priority: IssuePriority
  assigneeId: ID
  labelIds: [ID!]
  parentId: ID
  startDate: DateTime
  dueDate: DateTime
  "Hours, 0 to 100 000."
  estimateHours: Float
  "1, 2, 3, 5, 8, 13 or 21 (else 400 `issues.errors.points-off-scale`); only for a Story, Task or Bug (else 409 `issues.errors.points-not-allowed`)."
  points: Int
}

"""
A field left out stays as it is. Null clears `assigneeId`, `parentId`,
`startDate`, `dueDate`, `estimateHours` and `points`, and is refused for the others. The status changes
with `moveIssue`. A new `type` or `parentId` is checked against the rules of
`IssueType` (and a new type against the issue's children); a link that already
broke them is left alone until it is edited.
"""
input UpdateIssueInput {
  title: String @constraint(minLength: 1, maxLength: 200)
  type: IssueType
  description: String @constraint(maxLength: 50000)
  priority: IssuePriority
  assigneeId: ID
  labelIds: [ID!]
  parentId: ID
  startDate: DateTime
  dueDate: DateTime
  "Hours, 0 to 100 000; null clears it."
  estimateHours: Float
  "As on `CreateIssueInput`; null clears it. Moving the issue to an Epic or a Sub-task type clears its points."
  points: Int
}

"""
One patch for many issues; a field left out stays as it is. Null clears
`assigneeId`, `dueDate`, `estimateHours` and `points`, and is refused for the others.
`addLabelIds` are added to each issue's labels, then `removeLabelIds` taken
off (an id in both is removed). `statusId` puts each issue at the end of that
status.
"""
input BulkUpdateIssueInput {
  statusId: ID
  priority: IssuePriority
  assigneeId: ID
  addLabelIds: [ID!]
  removeLabelIds: [ID!]
  dueDate: DateTime
  "Hours, 0 to 100 000; null clears it."
  estimateHours: Float
  "As on `UpdateIssueInput`; null clears it. An Epic or Sub-task among the issues is listed in `failures` (409 `points-not-allowed`)."
  points: Int
}

"An issue the bulk update refused, with the code and message `updateIssue` would have answered."
type BulkIssueFailure {
  id: ID!
  code: String!
  message: String!
}

type BulkUpdateIssuesResult {
  updated: [Issue!]!
  failures: [BulkIssueFailure!]!
}

"""
One line of the roadmap: an Epic, or the issues that have no Epic (`epic` is
null). Its dates are its own when it has them, else derived from its children
(the earliest start or due date, the latest due date; the cancelled ones left
out): `startDerived` and `endDerived` say which. `progress` counts its
children, in issues and in story points.
"""
type RoadmapRow {
  epic: Issue
  "The Epic is in a `done` status (always false for the No Epic row)."
  done: Boolean!
  start: DateTime
  end: DateTime
  startDerived: Boolean!
  endDerived: Boolean!
  progress: IssueProgress!
}

"The roadmap of a project: its Epics on a time axis."
type Roadmap {
  "The Epics that have a start or an end (their own or derived), the cancelled ones left out."
  epics: [RoadmapRow!]!
  "The Epics with no date at all, listed apart."
  undated: [RoadmapRow!]!
  "The Stories, Tasks and Bugs with no Epic, as one row; list them with `issues(filter: { noEpic: true })`."
  noEpic: RoadmapRow!
}

type Query {
  """
  The issues of a project, paged by cursor (`first` 1 to 100, default 50;
  default sort `number` ascending). Needs `issue:read`. 400
  `validation.errors.invalid-input` on `projectId`, `first` or `after`.
  """
  issues(
    projectId: ID!
    filter: IssueFilter
    sort: IssueSort
    first: Int = 50
    after: String
  ): IssueConnection!
  "One issue by its key (any case). 404 `issues.errors.not-found`. Needs `issue:read`."
  issue(key: String!): Issue!
  """
  The Epics of a project with their date range and progress, and the No Epic
  row. A constant number of reads, whatever the number of Epics. Needs
  `issue:read`. 400 `validation.errors.invalid-input` (`projectId`).
  """
  roadmap(projectId: ID!): Roadmap!
}

type Mutation {
  """
  Makes an issue at the end of its status. Needs `issue:write`. 404
  `projects.errors.not-found`; 400 `validation.errors.invalid-input`
  (`title`, `statusId`, `assigneeId`, `labelIds`, `parentId`, `dueDate`); 409
  `issues.errors.parent-not-allowed`, `parent-type-invalid` or `parent-required`
  (on `parentId`).
  """
  createIssue(input: CreateIssueInput!): Issue!
  """
  Changes the given fields. Needs `issue:write`. 404 `issues.errors.not-found`;
  409 `issues.errors.parent-cycle`; 409 `issues.errors.parent-not-allowed`,
  `parent-type-invalid` or `parent-required` (the type and parent it would
  leave the issue with); 409 `issues.errors.type-breaks-children`.
  """
  updateIssue(id: ID!, input: UpdateIssueInput!): Issue!
  """
  Applies one patch to 1 to 100 issues, each as `updateIssue` (and
  `moveIssue` for the status) would: same checks, its own activity entry and
  live event. An issue that is refused is listed in `failures` (`id`, `code`,
  `message`), the others are written: a partial success is not an error. An
  issue is written field by field and then moved, so a move that fails after
  the write (a lost conflict) is listed in `failures` with its fields kept.
  Needs `issue:write`. 400 `validation.errors.invalid-input` (`ids`, an empty
  patch, `statusId`, `estimateHours`).
  """
  updateIssues(
    ids: [ID!]! @constraint(minItems: 1, maxItems: 100)
    input: BulkUpdateIssueInput!
  ): BulkUpdateIssuesResult!
  """
  Puts the issue in a status, right after `beforeId` and right before
  `afterId` (the issues that end up above and below it; both optional, both in
  that status). With neither it goes to the end. Only this issue is written.
  409 `issues.errors.bad-placement` when a neighbour is elsewhere or the two
  are not in order. Needs `issue:write`.
  """
  moveIssue(id: ID!, statusId: ID!, beforeId: ID, afterId: ID): Issue!
  "Deletes an issue; its children lose their parent. Answers its id. Needs `issue:delete` (admin, owner)."
  deleteIssue(id: ID!): ID!
  "Adds the viewer to the watchers; repeatable. Needs `issue:write`."
  watchIssue(id: ID!): Issue!
  "Removes the viewer from the watchers; repeatable. Needs `issue:write`."
  unwatchIssue(id: ID!): Issue!
}
