enum SearchKind {
  issue
  project
  member
}

"""
What a search found, one list per kind, each best match first. A kind the
search left out, or the viewer may not read, is an empty list.
"""
type SearchResults {
  issues: [Issue!]!
  projects: [Project!]!
  members: [Member!]!
}

type Query {
  """
  Searches issues (title, key, description), projects (key, name, description)
  and members (name, e-mail) of the request's organisation, ranked best match
  first, at most `first` per kind (1 to 50, default 10). `kinds` defaults to
  every kind the viewer may read (`issue:read`, `project:read`, `member:read`);
  naming a kind the viewer may not read is 403 `auth.errors.forbidden`. An
  issue key (`ABC-12`) comes first. 400 `validation.errors.invalid-input` on an
  empty or over-long `query` (200 characters) or on `first`.
  """
  search(query: String!, kinds: [SearchKind!], first: Int = 10): SearchResults!
}
