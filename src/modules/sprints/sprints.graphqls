enum SprintState {
  "Collects issues; any number may exist."
  planned
  "Running; one per project."
  active
  "Finished: it keeps its done issues and takes no change."
  closed
}

enum UnfinishedIssues {
  "Move the unfinished issues to the next planned sprint (made when none exists)."
  NEXT_SPRINT
  "Send the unfinished issues back to the backlog."
  BACKLOG
}

"""
A time-boxed iteration of a project. Sprints exist while the project has
`sprintsEnabled`. Dates are instants; the UI shows them as calendar days.
"""
type Sprint {
  id: ID!
  projectId: ID!
  "1, 2, 3... in the order the project's sprints were made."
  number: Int!
  name: String!
  goal: String
  state: SprintState!
  startDate: DateTime
  endDate: DateTime
  "Set when the sprint is closed."
  closedAt: DateTime
  "The points of the sprint's issues when it started; 0 until then."
  committedPoints: Int!
  "The points of the issues done when it closed; 0 until then."
  completedPoints: Int!
  "Its issues' points and counts as they stand now (cancelled ones left out), for a planned, active or closed sprint; a list of sprints is one grouped read."
  progress: SprintProgress!
}

"""
A sprint's live scope, read from its issues as they stand (the cancelled ones
left out). Unlike `committedPoints` and `completedPoints`, it moves with every
change and is available for a planned, active or closed sprint.
"""
type SprintProgress {
  "The story points of the sprint's issues; an unestimated issue counts for none."
  points: Int!
  "The story points of the issues in a `done` status."
  pointsDone: Int!
  "How many issues the sprint holds."
  issues: Int!
  "How many of them are in a `done` status."
  issuesDone: Int!
}

input CreateSprintInput {
  "Defaults to `Sprint <number>`."
  name: String @constraint(minLength: 1, maxLength: 100)
  goal: String @constraint(maxLength: 1000)
  startDate: DateTime
  "On or after `startDate`."
  endDate: DateTime
}

"A field left out is unchanged; `name` cannot be cleared, `goal` and the dates can."
input UpdateSprintInput {
  name: String @constraint(minLength: 1, maxLength: 100)
  goal: String @constraint(maxLength: 1000)
  startDate: DateTime
  endDate: DateTime
}

input StartSprintInput {
  "Defaults to the sprint's own name."
  name: String @constraint(minLength: 1, maxLength: 100)
  goal: String @constraint(maxLength: 1000)
  startDate: DateTime!
  "Defaults to `startDate` plus the project's `sprintLengthWeeks`."
  endDate: DateTime
}

input CloseSprintInput {
  unfinished: UnfinishedIssues!
  "With NEXT_SPRINT: the planned sprint that takes them; the next planned one by number when left out."
  nextSprintId: ID
}

"One day of a sprint's burndown, in the organisation's time zone."
type BurndownPoint {
  "The organisation's day, `YYYY-MM-DD`."
  day: String!
  "Points still to do on the straight line from the committed scope to 0 on the last day."
  ideal: Float!
  "Points still to do at the end of the day; null for a day to come."
  remainingPoints: Int
  "The points of the sprint's issues (cancelled ones left out); null for a day to come."
  scopePoints: Int
  "The points of the done issues; null for a day to come."
  completedPoints: Int
}

"A sprint's burndown: one point per day from its start to its end (or to today when it runs over)."
type SprintBurndown {
  sprintId: ID!
  committedPoints: Int!
  "The organisation's IANA time zone the days are in."
  timeZone: String!
  "Empty while the sprint is planned."
  points: [BurndownPoint!]!
}

"A closed sprint in the velocity."
type VelocitySprint {
  sprintId: ID!
  number: Int!
  name: String!
  committedPoints: Int!
  completedPoints: Int!
  closedAt: DateTime
}

"The project's recent closed sprints, oldest first, and their mean completed points (one decimal; 0 with none)."
type Velocity {
  sprints: [VelocitySprint!]!
  average: Float!
}

extend type Query {
  """
  The sprints of a project, by number, optionally only those in `states`.
  Needs `sprint:read`. 404 `projects.errors.not-found`.
  """
  sprints(projectId: ID!, states: [SprintState!]): [Sprint!]!
  """
  The burndown of a started sprint (active or closed), day by day; today's
  point is read from the issues, the earlier ones from the snapshots taken
  at the start, on each scope change, daily at the organisation's midnight and
  at the close. Needs `sprint:read`. 404 `sprints.errors.not-found`.
  """
  sprintBurndown(id: ID!): SprintBurndown!
  """
  The last `last` closed sprints of a project (6 by default, 1 to 50) and their
  mean completed points. Needs `sprint:read`. 404 `projects.errors.not-found`.
  """
  velocity(
    projectId: ID!
    last: Int! = 6 @constraint(min: 1, max: 50)
  ): Velocity!
}

extend type Mutation {
  """
  Makes a planned sprint. Needs `sprint:write`. 409 `sprints.errors.disabled`
  (the project has sprints off), `issues.errors.project-archived`; 400 on a
  bad input (an end before the start).
  """
  createSprint(projectId: ID!, input: CreateSprintInput!): Sprint!
  """
  Changes a planned or active sprint. Like `deleteSprint`, `startSprint`,
  `closeSprint` and `planIssues`, it takes an optional `projectId`, the project
  the caller works in: a sprint, issue, target or `nextSprintId` of another
  project is refused with 409 `sprints.errors.wrong-project`. Needs `sprint:write`. 404
  `sprints.errors.not-found`; 409 `sprints.errors.closed`.
  """
  updateSprint(id: ID!, input: UpdateSprintInput!, projectId: ID): Sprint!
  """
  Deletes a planned sprint; its issues go back to the backlog. Answers its id.
  Needs `sprint:write`. 404 `sprints.errors.not-found`; 409
  `sprints.errors.not-planned`, `sprints.errors.wrong-project`.
  """
  deleteSprint(id: ID!, projectId: ID): ID!
  """
  Starts a planned sprint and snapshots its scope as `committedPoints`. Needs
  `sprint:write`. 404 `sprints.errors.not-found`; 409
  `sprints.errors.not-planned`, `sprints.errors.active-exists` (one active
  sprint per project), `sprints.errors.disabled`, `sprints.errors.wrong-project`.
  """
  startSprint(id: ID!, input: StartSprintInput!, projectId: ID): Sprint!
  """
  Closes the active sprint: the done and cancelled issues stay with it, the
  others move as `unfinished` says; `completedPoints` is set. Needs
  `sprint:write`. 404 `sprints.errors.not-found`; 409
  `sprints.errors.not-active`, `sprints.errors.not-planned` (the chosen next
  sprint is not planned), `sprints.errors.wrong-project` (the sprint, or a
  `nextSprintId` of another project).
  """
  closeSprint(id: ID!, input: CloseSprintInput!, projectId: ID): Sprint!
  """
  Puts issues in a sprint (`sprintId` null: the backlog), after `afterId` and
  before `beforeId` (either or both left out; the end of the sprint with
  neither). The issues of one project, in the order given; answers them as
  they now stand. Needs `sprint:write`. 404 `sprints.errors.not-found`,
  `issues.errors.not-found`; 409 `sprints.errors.closed` (the target, or a
  sprint the issues are done in), `sprints.errors.type-not-allowed` (an epic
  or a sub-task), `sprints.errors.disabled`, `issues.errors.bad-placement`,
  `sprints.errors.wrong-project` (a target sprint or issues of another
  project).
  """
  planIssues(
    ids: [ID!]! @constraint(minItems: 1, maxItems: 100)
    sprintId: ID
    afterId: ID
    beforeId: ID
    projectId: ID
  ): [Issue!]!
}
