"""
A key the widget of a project is embedded with. The key is public by design: it
reads its own configuration and sends reports for its project, nothing else.
"""
type WidgetKey {
  id: ID!
  projectId: ID!
  "`pk_live_` and 32 characters: the value of `data-project-key`."
  publicKey: String!
  label: String!
  "The sites (`https://host[:port]`) allowed to use it; the public endpoint answers CORS for these only."
  allowedOrigins: [String!]!
  "Off, the widget answers `enabled: false` and takes no report."
  active: Boolean!
  "On by default. Off, the widget hides its screenshot and file controls and the key takes no file."
  attachmentsEnabled: Boolean!
  "When it was last used, to the minute; null if never."
  lastUsedAt: DateTime
  "When the identity secret was last generated; null if the key has none (reports then cannot be identified). The secret itself is never readable."
  identitySecretSetAt: DateTime
  "Files stored through this key (the quarantined or released ones the widget sent), ever."
  uploads: Int!
  "File refusals through this key, by reason, the most frequent first."
  refusals: [WidgetKeyRefusal!]!
  createdAt: DateTime!
  updatedAt: DateTime!
}

"""
A freshly generated identity secret, the only time it is shown. The host signs
its identity tokens with it on its own server, never in a browser.
"""
type WidgetIdentitySecret {
  key: WidgetKey!
  secret: String!
}

"""
How many times the key's file traffic was refused for one reason. `reason` is
the slug of an `intake.errors.` code: `attachments-disabled`, `too-many-files`,
`files-too-large`, `file-unsupported-type`, `file-undecodable`, `file-too-large`,
`file-too-many-pixels`, `quarantine-full`, `ticket-invalid`, `ticket-expired`,
`ticket-used`, `upload-mismatch`, `too-many-requests`.
"""
type WidgetKeyRefusal {
  reason: String!
  count: Int!
}

input CreateWidgetKeyInput {
  projectId: ID!
  label: String! @constraint(minLength: 1, maxLength: 100)
  allowedOrigins: [String!]!
    @constraint(minItems: 1, maxItems: 20, maxLength: 200)
  "Default true."
  attachmentsEnabled: Boolean
}

"A field left out stays as it is; null is refused."
input UpdateWidgetKeyInput {
  label: String @constraint(minLength: 1, maxLength: 100)
  allowedOrigins: [String!]
    @constraint(minItems: 1, maxItems: 20, maxLength: 200)
  active: Boolean
  attachmentsEnabled: Boolean
}

enum ClientReportState {
  new
  accepted
  declined
  closed
}

"How much the problem blocks the reporter. Prefills the priority at acceptance: blocking High, annoying Medium, minor Low."
enum ClientReportImpact {
  blocking
  annoying
  minor
}

"What the reporter says it is. Becomes the type of the issue an acceptance makes: bug to Bug, suggestion to Story, question to Task. A report with no type makes a Task. No label is made."
enum ClientReportType {
  bug
  question
  suggestion
}

type ClientReportMetadata {
  key: String!
  value: String!
}

"""
A report a reader sent through the widget. Everything in it is text from a
stranger: show it as plain text, never as markup or links.
"""
type ClientReport {
  id: ID!
  projectId: ID!
  title: String!
  description: String!
  "Null if none was given, or once erased (90 days after the report is closed or declined)."
  email: String
  state: ClientReportState!
  "The issue an acceptance made, or the one the report was linked to. Several reports may share one."
  issueId: ID
  "What the reporter said about the impact, if anything."
  impact: ClientReportImpact
  "What the reporter said it is, if anything."
  type: ClientReportType
  """
  What the reporter sees: `declined` when the report was declined or its issue
  sits in a status mapped to `declined`; `resolved` when the reporter resolved
  it and has not reopened since; `inProgress` after a reopen until the issue's
  mapped state next changes; otherwise the state of the issue's status
  (`Status.publicState`), `received` before any issue.
  """
  publicState: PublicState!
  declineReason: String
  """
  Whether the reporter reads `declineReason`: true for a decline made since
  widget v3, false for the earlier ones, whose reason stays with the team.
  """
  declineReasonPublic: Boolean!
  "When the report was linked to an existing issue; null if it made its own or none."
  linkedAt: DateTime
  "True while the reporter wrote last in the request thread and the team has not replied publicly since."
  clientWaiting: Boolean!
  pageUrl: String
  userAgent: String
  locale: String!
  metadata: [ClientReportMetadata!]!
  decidedBy: ID
  decidedAt: DateTime
  closedAt: DateTime
  erasedAt: DateTime
  """
  The files the reader attached, oldest first (the ones whose bytes arrived).
  Needs `issue:write`, like the report: while a file is quarantined only
  those who triage read it.
  """
  files: [ClientReportFile!]!
  """
  How many of the attached files are not stored yet: the upload is still
  expected (the slot is reserved and has not expired). Needs
  `issue:write`, like `files`.
  """
  pendingFiles: Int!
  createdAt: DateTime!
}

enum ClientReportFileRole {
  screenshot
  file
  "Sent by the reporter in a reply of their request thread."
  reply
}

"""
Where a stored file stands: `quarantined` (readable by those who triage only)
or `released` (its report was accepted: readable by readers of the issue).
"""
enum ClientReportFileState {
  quarantined
  released
}

"""
A file a reader attached to a report. The bytes are served by the media
routes (`url`, `previewUrl`), through the UI server only: `GET` with the
Bearer token and the organisation header. A picture's `url` is its whole
picture (WebP, at most 2560 px; the upload itself is never kept); a PDF's is
the PDF, served as a download. Its name and its content come from a stranger.
"""
type ClientReportFile {
  id: ID!
  reportId: ID!
  role: ClientReportFileRole!
  "The reporter's message a `reply` file belongs to; null for the others."
  messageId: ID
  fileName: String!
  mime: String!
  "Bytes of the upload."
  size: Int!
  state: ClientReportFileState!
  "Pixels, for a picture; null for a PDF."
  width: Int
  height: Int
  "The file, relative to the API."
  url: String!
  "A 256 px square thumbnail (WebP); null for a PDF that could not be drawn."
  previewUrl: String
  createdAt: DateTime!
}

type ClientReportConnection {
  nodes: [ClientReport!]!
  "Pass it as `after` for the next page; null on the last."
  endCursor: String
  hasNextPage: Boolean!
}

type Query {
  """
  The widget keys of a project, oldest first; revoked ones are not listed.
  Needs `intake:manage` (admin, owner). 404 `projects.errors.not-found`.
  """
  widgetKeys(projectId: ID!): [WidgetKey!]!
  """
  The project's client reports, newest first, paged by cursor (`first` 1 to
  100, default 50), optionally of one `state`. Needs `issue:write` (those who
  triage). 404 `projects.errors.not-found`.
  """
  clientReports(
    projectId: ID!
    state: ClientReportState
    first: Int = 50
    after: String
  ): ClientReportConnection!
  """
  The files released to an issue from its client report (the report was
  accepted), oldest first: show them as "from the client report", apart from
  the issue's own attachments (they are not counted in the 20 per owner and
  are not copied). Empty for an issue that came from no report. Needs
  `attachment:read`. 404 `issues.errors.not-found`.
  """
  issueClientReportFiles(issueId: ID!): [ClientReportFile!]!
}

type Mutation {
  """
  Makes a key for a project. Needs `intake:manage` and a recent proof of
  identity (403 `auth.errors.step-up-required`). 400
  `intake.errors.invalid-origin` on `allowedOrigins`; 404
  `projects.errors.not-found`.
  """
  createWidgetKey(input: CreateWidgetKeyInput!): WidgetKey!
  "Needs `intake:manage`. 404 `intake.errors.key-not-found`."
  updateWidgetKey(id: ID!, input: UpdateWidgetKeyInput!): WidgetKey!
  """
  Gives the key a new value; the old one stops working at once. Needs
  `intake:manage` and a recent proof of identity.
  """
  rotateWidgetKey(id: ID!): WidgetKey!
  """
  Makes a new identity secret for the key and shows it once; it is stored
  sealed. The previous secret stops working at once: tokens signed with it are
  refused. Needs `intake:manage` and a recent proof of identity (403
  `auth.errors.step-up-required`); 404 `intake.errors.key-not-found`.
  """
  generateWidgetIdentitySecret(keyId: ID!): WidgetIdentitySecret!
  """
  Retires the key for good: it answers like an unknown one. Answers its id.
  Needs `intake:manage`.
  """
  revokeWidgetKey(id: ID!): ID!
  """
  Accepts a new report: an issue is made from it in the project's Triage
  status, linked both ways, and its files are released to the issue. Needs `issue:write`. 409
  `intake.errors.report-decided`; 404 `intake.errors.not-found`.
  """
  acceptClientReport(id: ID!): ClientReport!
  """
  Declines a new report with a reason. The reporter reads the reason
  (`declineReasonPublic` is true), so write it for them. Its files stay
  quarantined until the purge (7 days after the decision). Needs
  `issue:write`. 409 `intake.errors.report-decided`.
  """
  declineClientReport(
    id: ID!
    reason: String! @constraint(minLength: 1, maxLength: 1000)
  ): ClientReport!
  """
  Accepts a new report into an issue of the same project that already exists
  (a duplicate): no issue is made, the report follows the issue (its closing
  and reopening) and its files are released to it. Several reports may share
  one issue. Needs `issue:write`. 409 `intake.errors.report-decided`, 409
  `issues.errors.project-archived`; 404 `intake.errors.not-found` (report) or
  `issues.errors.not-found` (issue); 400 `validation.errors.invalid-input`
  (`issueId`, an issue of another project).
  """
  linkClientReport(id: ID!, issueId: ID!): ClientReport!
}
