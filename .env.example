# Copy to .env, which Bun loads on every command: bun run dev, bun test, bun start.
# `bun test` and `bun run verify` need nothing below.

# number, optional, default 3000
PORT=3000

# Host ports of the dev services (docker-compose.yml). They differ from operix-api's so both
# stacks can run side by side. Change a port together with the URL that uses it.
# MONGO_PORT=27018
# REDIS_PORT=6380
# MAILPIT_SMTP_PORT=1026
# MAILPIT_WEB_PORT=8026
# S3_PORT=9002
# S3_CONSOLE_PORT=9003

# mongodb://, required. docker-compose.yml starts a one-node replica set on MONGO_PORT.
MONGO_URI=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
# Sign-in by an e-mailed link. Off by default: off, a request is answered as for an unknown
# address (nothing sent), a confirmation is refused 503 auth.errors.unavailable, and
# authConfig.magicLink is false. 1, true, yes or on turns it on.
# PULSARIX_MAGIC_LINK=false
# How many organisations' databases stay open (least recently used out), integer 1 to 10000,
# default 100. Raise it when more organisations are active at once than that.
# MONGO_ORGANISATION_CACHE_SIZE=100
# The core database and the prefix of each organisation's (`<prefix><id>`).
# MONGO_CORE_DATABASE=pulsarix_core
# MONGO_ORGANISATION_PREFIX=pulsarix_org_
# pulsarix-ui's origin: every link of a mail starts with it (https in production).
# UI_ORIGIN=http://localhost:5173
# The address mails are sent from.
# MAIL_FROM=noreply@pulsarix.test
# smtp:// or smtps:// (Mailpit: smtp://localhost:1026); unset, mails are printed to the console.
# MAIL_URL=smtp://localhost:1026
# Sealing keys of the second factor, `id:key,...`, each key from `openssl rand -base64 32`.
# Required in production; a fixed development key stands in elsewhere.
# TOTP_KEYS=
# The chronix host (time tracking, link API at /link/graphql). Default https://chronix.softistx.com.
# The organisation's link key is set by an admin (`linkChronix`), sealed with TOTP_KEYS.
# CHRONIX_URL=https://chronix.softistx.com
# redis://, required in production. Live events (subscriptions) cross API instances through it;
# unset elsewhere, they stay in the one process. docker-compose.yml: redis://localhost:6380.
# REDIS_URL=redis://localhost:6380
# Proxies in front of the API (addresses or CIDR ranges, comma separated; the docker network is
# 172.16.0.0/12). The client address of the public endpoint's rate limits is read from
# X-Forwarded-For past these proxies only. Unset, it is the connection's address.
# TRUSTED_PROXIES=172.16.0.0/12
# S3-compatible store of the attachments; set the three together or none (the media routes answer
# 503 without them). docker-compose.yml's MinIO: http://localhost:9002, bucket pulsarix-media.
# S3_ENDPOINT=http://localhost:9002
# S3_REGION=
# S3_BUCKET=pulsarix-media
# S3_ACCESS_KEY=pulsarix-dev
# S3_SECRET_KEY=pulsarix-dev-secret
