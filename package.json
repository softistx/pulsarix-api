{
  "name": "pulsarix-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && graphql-codegen --config codegen.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "NODE_ENV=development bun --watch src/server.ts",
    "services:up": "docker compose up -d --wait mongo redis mailpit minio && docker compose up -d media-bucket",
    "services:down": "docker compose down",
    "build": "bun run generate && bun build src/server.ts --target=bun --outdir=dist --minify --sourcemap=linked",
    "start": "NODE_ENV=production bun dist/server.js",
    "schema:print": "bun src/scripts/schema-print.ts",
    "test": "bun test --timeout=15000",
    "typecheck": "bun check",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "context:check": "bun src/scripts/context-codes-check.ts",
    "check:ci": "biome ci && bun run context:check",
    "verify": "bun run generate && bun run schema:print --check && bun run check:ci && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@alxia/core": "^0.20.0",
    "@alxia/env": "^0.5.0",
    "@alxia/graphql": "^0.15.0",
    "@alxia/modules": "^0.4.0",
    "@graphql-tools/merge": "^10.0.6",
    "@nxgt/graphql-scalars": "^0.7.1",
    "@nxgt/graphql-validation": "^0.8.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-tools/utils": "^13.1.3",
    "@nxgt/graphql-codegen-zod": "^0.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
